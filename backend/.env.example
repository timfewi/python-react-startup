# Backend environment template (do NOT store real prod secrets)
APP_NAME=python-react-startup
ENV=dev
API_V1_PREFIX=/api/v1
LOG_LEVEL=info

# CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (when you add one)
# DATABASE_URL=postgresql://user:password@localhost:5432/db_name

# Security (set SECRET_KEY only via real env var in prod; okay to set locally)
# SECRET_KEY=change-me
# ACCESS_TOKEN_EXPIRE_MINUTES=30

# External APIs (examples)
# EXTERNAL_API_KEY=your-api-key-here
# EXTERNAL_API_URL=https://api.example.com
